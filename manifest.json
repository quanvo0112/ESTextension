{
  "manifest_version": 3,
  "name": "Subjects Table Extractor",
  "version": "1.2.3",
  "description": "Extract tables to TXT or JSON with tab separators",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "src/shared/table-extractor.js",
      "src/content/content.js"
    ]
  }]
}
